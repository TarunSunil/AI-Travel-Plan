# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
SECRET_KEY=replace_with_strong_hex

# ── Free Travel APIs (optional but recommended) ───────────────────────────────
# AviationStack – 500 req/month free, real flight schedules
# Sign up: `https://aviationstack.com`
AVIATIONSTACK_KEY=your_aviationstack_api_key

# OpenTripMap – 5000 req/day free, real hotel & POI names
# Sign up: `https://opentripmap.io/product`
OPENTRIPMAP_KEY=your_opentripmap_api_key

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_API_KEY=your_firebase_public_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# ── Optional ──────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
# SUPABASE_URL=`https://your-project.supabase.co`
# SUPABASE_KEY=your_anon_public_key
# DATABASE_URL=postgresql://...
